BEGIN Configuration File: runfiles/lab2_mesh8x8.cfg
// DAT575 Lab 2: 8x8 mesh, uniform random traffic

// Topology and routing
topology         = mesh;
k                = 8;        // 8 routers per dimension
n                = 2;        // 2 dimensions: 8x8 = 64 nodes
routing_function = dor;      // dimension-order: X first, then Y

// Traffic
traffic          = uniform;  // every node sends to random destinations
packet_size      = 1;        // flits per packet
injection_rate   = 0.1;      // packets per node per cycle
use_read_write   = 0;

// Flow control
num_vcs              = 4;
vc_buf_size          = 8;    // flits per VC
wait_for_tail_credit = 0;
vc_busy_when_full    = 1;    // a VC with no free buffer slot counts as busy

// Router pipeline: RC, VA, SA, ST (cycles per stage)
routing_delay    = 1;
vc_alloc_delay   = 1;
sw_alloc_delay   = 1;
st_prepare_delay = 0;
st_final_delay   = 1;
speculative      = 0;
credit_delay     = 0;        // extra cycles on top of the 1-cycle credit link

// Allocators
vc_allocator     = separable_input_first;  // honours the priorities of the routing function
sw_allocator     = islip;
alloc_iters      = 1;
priority         = none;
input_speedup    = 1;
output_speedup   = 1;
internal_speedup = 1.0;

// Simulation
sim_type          = latency;
sample_period     = 10000;
warmup_periods    = 3;
max_samples       = 10;
sim_count         = 1;
print_csv_results = 1;

// Random seed: replace <group number> with your group number (1-8)
seed = 7;

END Configuration File: runfiles/lab2_mesh8x8.cfg
